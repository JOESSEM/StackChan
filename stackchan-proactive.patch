+// [proactive] Reminder messages waiting to be spoken by the AI agent
+static std::mutex _proactive_mutex;
+static std::string _proactive_pending;
+static uint32_t _proactive_pending_since = 0;
+static constexpr uint32_t kProactiveMaxWaitMs = 10 * 60 * 1000;
+
+static void _proactive_queue(std::string_view msg)
+{
+    std::lock_guard<std::mutex> lock(_proactive_mutex);
+    _proactive_pending       = std::string(msg);
+    _proactive_pending_since = GetHAL().millis();
+}
+
+static void _proactive_update()
+{
+    std::string text;
+    {
+        std::lock_guard<std::mutex> lock(_proactive_mutex);
+        if (_proactive_pending.empty()) {
+            return;
+        }
+        if (GetHAL().millis() - _proactive_pending_since > kProactiveMaxWaitMs) {
+            mclog::tagInfo(_tag, "proactive message expired: {}", _proactive_pending);
+            _proactive_pending.clear();
+            return;
+        }
+        if (!hal_bridge::is_xiaozhi_ready() || !hal_bridge::is_xiaozhi_idle()) {
+            return;  // user is talking or agent busy: try again later
+        }
+        text = _proactive_pending;
+    }
+    if (hal_bridge::xiaozhi_invoke_text(text)) {
+        mclog::tagInfo(_tag, "proactive invoke: {}", text);
+        std::lock_guard<std::mutex> lock(_proactive_mutex);
+        if (_proactive_pending == text) {
+            _proactive_pending.clear();
+        }
+    }
+}
+
+// [proactive] Spoken once after power-on (e.g. when the car starts)
+static constexpr const char* kProactiveBootMessage =
+    "[시동] 방금 전원이 켜졌어. get_schedule 도구로 오늘 일정을 확인해서 일정이 있으면 짧게 알려줘. "
+    "그다음 운전 중인지 물어보고, 운전 중이라고 하면 start_drive_mode 도구를 호출해.";
+
 static void _stackchan_update_task(void* param)
 {
     bool is_setup_done = false;
@@ -150,6 +197,7 @@ static void _stackchan_update_task(void* param)
         vTaskDelay(pdMS_TO_TICKS(20));
 
         tools::update_reminders();
+        _proactive_update();
 
         LvglLockGuard lock;
 
@@ -169,6 +217,7 @@ static void _stackchan_update_task(void* param)
             view::create_home_indicator([]() { GetHAL().requestWarmReboot(0); }, 0x81DBBD, 0x134233);
             view::create_status_bar(0x81DBBD, 0x134233);
             is_setup_done = true;
+            _proactive_queue(kProactiveBootMessage);
         }
 
         view::update_home_indicator();
@@ -194,6 +243,7 @@ void Hal::startXiaozhi()
             avatar.addDecorator(std::make_unique<view::ReminderView>(lv_screen_active(), msg));
