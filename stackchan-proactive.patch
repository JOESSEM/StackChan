+// [proactive] Let the AI agent speak first: the text is delivered to the server
+// through the wake-word channel (requires CONFIG_SEND_WAKE_WORD_DATA=y) and the
+// agent answers it like a user utterance.
+bool hal_bridge::xiaozhi_invoke_text(const std::string& text)
+{
+    auto& app = Application::GetInstance();
+    if (app.GetDeviceState() != kDeviceStateIdle) {
+        return false;
+    }
+    app.Schedule([text]() { Application::GetInstance().WakeWordInvoke(text); });
+    return true;
+}
